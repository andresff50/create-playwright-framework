{
  "language": "es",
  "name": "mi-framework-poetry",
  "lang": "py",
  "packageManager": "poetry",
  "size": "large",
  "baseUrl": "https://playwright.dev",
  "envs": [
    "dev",
    "qa",
    "staging"
  ],
  "browsers": [
    "chromium",
    "firefox"
  ],
  "reporters": [
    "html",
    "junit",
    "allure",
    "metrics"
  ],
  "api": true,
  "db": "postgres",
  "data": true,
  "auth": true,
  "extras": [
    "a11y"
  ],
  "bdd": true,
  "docker": "compose",
  "ci": [
    "github",
    "jenkins",
    "gitlab",
    "azure"
  ],
  "shards": 3,
  "lint": true,
  "precommit": true,
  "claude": true,
  "git": true
}
