{
  "name": "create-pw-framework",
  "version": "1.1.0",
  "private": true,
  "description": "Generador interactivo de frameworks Playwright (TypeScript o Python, español o inglés)",
  "type": "module",
  "bin": {
    "create-pw-framework": "create-pw-framework.mjs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:update-golden": "npm run build && node tests/helpers/update-golden.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "yaml": "^2.9.1"
  }
}
